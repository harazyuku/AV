POSTGRES_DB=av_search
POSTGRES_USER=av
POSTGRES_PASSWORD=av
DATABASE_URL=postgresql+psycopg://av:av@db:5432/av_search
# 本番では公開フロントのオリジンを指定。複数ある場合はカンマ区切り
CORS_ALLOW_ORIGINS=http://localhost:3000
# ユーザーの希望を検索条件JSONへ変換し、Embeddingを作るAI  「line.atのアカウント」
QUERY_AI_API_KEY=
QUERY_AI_MODEL=gemini-3.5-flash
QUERY_AI_EMBEDDING_MODEL=gemini-embedding-2

# MissAVから取得した動画フレームを作品JSONへ変換するAI　「ikehara.yuto.gaku@gmail.com」
IMPORT_AI_API_KEY=
IMPORT_AI_API_KEY_2=
IMPORT_AI_API_KEY_3=
IMPORT_AI_API_KEY_4=
IMPORT_AI_API_KEY_5=
IMPORT_AI_MODEL=gemini-3.5-flash
# 動画全体から均等に切り出してGeminiへ送る静止画の枚数と横幅
IMPORT_FRAME_COUNT=30
IMPORT_FRAME_WIDTH=448
IMPORT_FRAME_JPEG_QUALITY=8
# 30枚を6枚ずつ分け、IMPORT_AI_API_KEY〜_5へ順番に割り当てる
IMPORT_IMAGES_PER_KEY=6

# 5体の画像解析報告だけを1つの visual_analysis JSONへ統合するGemini
# 未設定の場合は IMPORT_AI_API_KEY を使用する
DESCRIPTION_AI_API_KEY=
DESCRIPTION_AI_MODEL=gemini-3.5-flash
# FANZA公式商品画像・商品情報API用
FANZA_API_ID=
FANZA_AFFILIATE_ID=
MAX_VIDEO_BYTES=2147483648

# 自動取込（1日1〜10本）。新着・一覧ページのURLを指定して有効化する
AUTO_IMPORT_ENABLED=false
MISSAV_FEED_URL=
AUTO_IMPORT_DAILY_LIMIT=20
AUTO_IMPORT_POLL_SECONDS=21600
AUTO_IMPORT_BETWEEN_ITEMS_SECONDS=3600
AUTO_IMPORT_MAX_ATTEMPTS=3
AUTO_IMPORT_TIMEZONE=Asia/Tokyo

# falseなら解析後に動画・抽出JSONを削除し、DBの検索用JSONだけを残す
KEEP_SOURCE_VIDEO=false
